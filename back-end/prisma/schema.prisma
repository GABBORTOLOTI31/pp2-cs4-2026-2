generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// O nome de um model no Prisma:
///  * deve iniciar com letra maiúscula
///  * deve estar no singular
model Customer {
  id             Int       @id @default(autoincrement())
  name           String
  ident_document String    @unique
  birth_date     DateTime? @db.Date
  street_name    String
  house_number   String
  complements    String?
  district       String
  municipality   String
  state          String    @db.Char(2)
  phone          String
  email          String    @unique
}
